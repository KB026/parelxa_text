# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App URL Configuration
NEXT_PUBLIC_APP_URL=https://parlexa.in
NEXT_PUBLIC_SITE_URL=https://parlexa.in

# Third-Party API Keys (Required for Production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Plan IDs
RAZORPAY_MONTHLY_GROWTH_PLAN_ID=your_growth_monthly_plan_id
RAZORPAY_MONTHLY_SCALE_PLAN_ID=your_scale_monthly_plan_id
RAZORPAY_YEARLY_GROWTH_PLAN_ID=your_growth_yearly_plan_id
RAZORPAY_YEARLY_SCALE_PLAN_ID=your_scale_yearly_plan_id

RESEND_API_KEY=your_resend_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# AI Models & Services
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Monitoring & Error Tracking
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
